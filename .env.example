# Copy to .env (git-ignored) to turn on the AI panel in `pnpm dev`.
# The key is read only by the dev server and never sent to the page.
ANTHROPIC_API_KEY=
# Default model for a browser that has not picked one: claude-opus-5-5, claude-sonnet-5-5,
# claude-haiku-5-5, or one of TF_AI_OPENAI_MODELS.
# TF_AI_MODEL=claude-opus-5-5

# Or (and) an OpenAI-compatible server, such as a local Ollama. The models are
# the ones the editor may use there, comma-separated; the key is optional.
# The URL must be https, or http to this machine (localhost, 127.0.0.1).
# Ollama: give it a context of at least 32k tokens (OLLAMA_CONTEXT_LENGTH=32768),
# or it cuts the guide off without saying so.
# TF_AI_OPENAI_URL=http://localhost:11434/v1
# TF_AI_OPENAI_MODELS=qwen3:8b
# TF_AI_OPENAI_KEY=

# Editor deploy (`pnpm upload:editor`): uploads apps/editor/dist/ to the root of
# its own FTP account, over FTPS only. Secure: explicit (default, port 21) or implicit (990).
# The Deploy editor GitHub workflow reads the same names from the secrets of
# the repository's `editor-ftp` environment.
# EDITOR_FTP_HOST=
# EDITOR_FTP_USER=
# EDITOR_FTP_PASS=
# EDITOR_FTP_SECURE=
# EDITOR_FTP_PORT=

# The deployed editor's AI (`pnpm ai:setup`): the key its PHP proxy uses, kept
# on the server only. Use a key made for this, with a monthly spending limit.
# EDITOR_AI_ANTHROPIC_KEY=
# The site that pnpm ai:setup checks afterwards.
# EDITOR_SITE_URL=https://tf.basille.net
# Saving from the site (`pnpm ai:setup`): a fine-grained GitHub token for this
# repository only, with Contents read and write, and an expiry date. Commits
# go to the web branch; merge it into master from your computer.
# EDITOR_GITHUB_TOKEN=
# EDITOR_GITHUB_REPO=obasille/tinyforge
# EDITOR_GITHUB_BRANCH=web
