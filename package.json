{
  "name": "tinyforge",
  "version": "0.1.0",
  "private": true,
  "description": "A simplified game platform for rapidly prototyping and experimenting with 2D game ideas",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @tinyforge/editor dev",
    "dev:classic": "pnpm run build:classic && pnpm run serve",
    "build": "tsc -p apps/classic/src/tsconfig.json && node scripts/build-games.js",
    "build:host": "tsc -p apps/classic/src/tsconfig.json",
    "build:classic": "tsc -p apps/classic/src/tsconfig.json && node scripts/build-games.js",
    "build:games": "node scripts/build-games.js",
    "build:debug": "node scripts/build-games.js debug",
    "build:editor": "pnpm --filter @tinyforge/editor build",
    "editor:static": "pnpm run build:editor && pnpm --filter @tinyforge/editor preview",
    "tf": "node scripts/tf.js",
    "check:alloc": "node scripts/check-alloc.js",
    "test": "pnpm -r --if-present test",
    "test:sdk": "node scripts/test-utility.js",
    "test:e2e": "pnpm --filter @tinyforge/editor test:e2e",
    "test:e2e:static": "pnpm --filter @tinyforge/editor test:e2e:static",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check . && eslint .",
    "format": "biome format --write .",
    "watch": "concurrently --kill-others --prefix-colors auto \"pnpm:watch:*\"",
    "watch:host": "tsc -p apps/classic/src/tsconfig.json --watch --preserveWatchOutput",
    "watch:games": "node scripts/watch-games.js",
    "upload": "node scripts/upload.js",
    "upload:editor": "node scripts/upload-editor.js",
    "ai:setup": "node scripts/editor-ai-setup.js",
    "serve": "node scripts/serve-classic.js 8080",
    "postbuild": "node scripts/upload.js --if-configured",
    "postbuild:host": "node scripts/upload.js --if-configured",
    "postbuild:games": "node scripts/upload.js --if-configured"
  },
  "keywords": [
    "tinyforge",
    "game-platform",
    "webassembly",
    "assemblyscript",
    "gamedev"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.20.5",
    "assemblyscript": "^0.28.9",
    "basic-ftp": "^5.0.5",
    "chokidar": "^3.6.0",
    "concurrently": "^9.2.5",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  }
}
