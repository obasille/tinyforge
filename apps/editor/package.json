{
  "name": "@tinyforge/editor",
  "version": "0.1.0",
  "private": true,
  "description": "The new TinyForge editor: React + Dockview shell over @tinyforge/editor-core",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --trace off",
    "test": "vitest run"
  },
  "dependencies": {
    "@tinyforge/editor-core": "workspace:*",
    "@tinyforge/engine": "workspace:*",
    "@tinyforge/runtime": "workspace:*",
    "dockview-react": "8.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tweakpane": "4.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tweakpane/core": "2.0.5",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "assemblyscript": "^0.28.20",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vite-plugin-checker": "1.0.0",
    "vitest": "5.1.1"
  }
}
