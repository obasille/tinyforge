{
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "src/assembly/sdk.*\\.ts|src/memory-map\\.ts$",
        "isAsync": true,
        "cmd": "npm run build"
      },
      {
        "match": "src/assembly/games.*\\.ts$",
        "isAsync": true,
        "cmd": "node scripts/build-game.js ${fileBasename}"
      },
      {
        "match": "(src/web.*\\.ts$|src/memory-map\\.ts$)",
        "isAsync": true,
        "cmd": "npm run build:host"
      }
    ]
  },
  "liveServer.settings.ignoreFiles": [
    // Don't watch any source file
    "**/src/**"
  ],
  "cSpell.words": [
    "changetype",
    "Cooldown",
    "invuln",
    "Mathf",
    "Platformer",
    "pset"
  ]
}
