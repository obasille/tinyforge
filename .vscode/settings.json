{
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "sdk.*\\.ts$",
        "isAsync": true,
        "cmd": "npm run build"
      },
      {
        "match": "src/games.*\\.ts$",
        "isAsync": true,
        "cmd": "node scripts/build-game.js ${fileBasename}"
      },
      {
        "match": "(src/web.*\\.ts$|memory-map\\.ts$)",
        "isAsync": true,
        "cmd": "npm run build:host"
      }
    ]
  },
  "liveServer.settings.ignoreFiles": [
    // Don't watch any source file
    "**/src/**"
  ]
}
