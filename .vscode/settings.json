{
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "sdk.*\\.ts$",
        "isAsync": true,
        "cmd": "npm run build"
      },
      {
        "match": "src/games.*\\.ts$",
        "isAsync": true,
        "cmd": "node scripts/build-game.js ${fileBasename}"
      },
      {
        "match": "(src/web.*\\.ts$|memory-map\\.ts$)",
        "isAsync": true,
        "cmd": "npm run build:host"
      }
    ]
  },
  "liveServer.settings.ignoreFiles": [
    // Don't watch games and sdk source files
    "**/src/games/*.ts",
    "**/src/sdk/*.ts",
    // Don't watch compiled WebAssembly files
    "**/dist/cartridges/*.wasm"
  ]
}
